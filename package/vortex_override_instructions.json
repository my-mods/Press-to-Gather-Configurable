[
  {
    "type": "attribute",
    "key": "customFileName",
    "value": "Press to Gather - Configurable"
  },
  {
    "type": "attribute",
    "key": "version",
    "value": "1.2"
  },
  {
    "type": "attribute",
    "key": "description",
    "value": "Hold B / Circle for 0.6 seconds by default to gather harvestable resources. Choose the controller button and a 10-200 metre distance in the optional Mod Settings menu; default 20 metres. Optional keyboard O shortcut."
  },
