<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Press to Gather - Configurable</name>
    <modid>PressToGather</modid>
    <description>Hold B / Circle for 0.6 seconds by default to gather harvestable resources. Choose the controller button and a 10-200 metre distance in the Mod Settings menu; default 20 metres. Optional keyboard O shortcut.</description>
    <author>Tic0311; personal controller customization</author>
    <version>1.4.1</version>
    <created_on>2026-09-10</created_on>
  </info>
  <supports>
    <game>The Blood of Dawnwalker</game>
    <steam_build>25915545</steam_build>
    <requires>UE4SS for Dawnwalker by Vercadi 1.3 (RC6) or later; game-thread delayed actions</requires>
    <requires>Mod Setting Menu 1.0.6 or later; HookProcessConsoleExec=1 for live Apply</requires>
  </supports>
</mod>
