<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Press to Gather - Configurable</name>
    <modid>PressToGather</modid>
    <description>Hold B / Circle for 0.6 seconds by default to gather harvestable resources. Choose the controller button and a 10-200 metre distance in the optional Mod Settings menu; default 20 metres. Optional keyboard O shortcut.</description>
    <author>Tic0311; personal controller customization</author>
    <version>1.1</version>
    <created_on>2026-09-10</created_on>
  </info>
  <supports>
    <game>The Blood of Dawnwalker</game>
    <steam_build>25232147</steam_build>
    <requires>UE4SS with game-thread delayed actions; reference Framecore 2b, 97b7e501c</requires>
    <optional>Dawnwalker Mod Settings 1.0.5 or later for the settings page</optional>
  </supports>
</mod>
