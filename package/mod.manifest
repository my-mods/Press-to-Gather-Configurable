<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Toggleable Auto Gather - Press to Gather</name>
    <modid>TogAutGat</modid>
    <description>Hold RB / R1 for 0.6 seconds to gather harvestable resources within 100 metres. Optional keyboard O shortcut.</description>
    <author>Tic0311; personal controller customization</author>
    <version>2</version>
    <created_on>2026-09-10</created_on>
  </info>
  <supports>
    <game>The Blood of Dawnwalker</game>
    <steam_build>25232147</steam_build>
    <requires>UE4SS with game-thread delayed actions; reference Framecore 2b, 97b7e501c</requires>
  </supports>
</mod>
